"use client";

import {
  create{{pascal}}InputSchema,
  type Create{{pascal}}Input,
} from "@ai-starter/domain";
import { zodResolver } from "@hookform/resolvers/zod";
import { useTranslations } from "next-intl";
import { useId, useState } from "react";
import { useForm } from "react-hook-form";

import { {{pascal}}FieldError } from "~/components/{{kebabPlural}}/{{kebab}}-field-error";
import { {{pascal}}RenameForm } from "~/components/{{kebabPlural}}/{{kebab}}-rename-form";
import { Button } from "~/components/ui/button";
import { Input } from "~/components/ui/input";
import { Label } from "~/components/ui/label";
import type { RouterOutputs } from "~/trpc/react";

/**
 * The record the interface renders, derived from what the procedure returns
 * rather than restated — a narrower projection upstream becomes a type error
 * here instead of an empty element.
 */
export type {{pascal}} = RouterOutputs["{{camel}}"]["list"][number];

/** The two outcomes a reader can act on differently. */
export type {{pascal}}Failure = "network" | "unexpected";

/**
 * Everything the {{lowerPlural}} screen shows, given the data.
 *
 * It takes records and callbacks rather than reaching for the API itself, so the
 * transport lives in one place above it and this stays provable without one.
 *
 * Every {{lower}} is editable in place, so the list renders one form per record.
 * That is why the rename form identifies its field with `useId` rather than a
 * name derived from the feature: a page with several of them would otherwise
 * repeat one DOM id, and a label would point at whichever field came first.
 */
export function {{pascal}}Panel({
  {{camelPlural}},
  failure,
  isCreating,
  isRenaming,
  onCreate,
  onRename,
  renameSaved,
}: {
  readonly {{camelPlural}}: readonly {{pascal}}[];
  readonly failure: {{pascal}}Failure | null;
  readonly isCreating: boolean;
  readonly isRenaming: boolean;
  readonly onCreate: (title: string) => void;
  readonly onRename: (input: { {{camel}}Id: string; title: string }) => void;
  readonly renameSaved: boolean;
}) {
  const t = useTranslations("app.{{camelPlural}}");
  const titleId = useId();
  const errorId = `${titleId}-error`;
  // Which row the reader last submitted. One mutation serves every form, so
  // without this each of them would report the confirmation of whichever row
  // was saved.
  const [savedId, setSavedId] = useState<string | null>(null);
  const {
    formState: { errors },
    handleSubmit,
    register,
    reset,
  } = useForm<Create{{pascal}}Input>({
    defaultValues: { title: "" },
    resolver: zodResolver(create{{pascal}}InputSchema),
  });

  return (
    <div className="space-y-8">
      <p className="text-muted-foreground text-sm">
        {t("count", { count: {{camelPlural}}.length })}
      </p>

      {failure === null ? null : (
        <p
          className="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border px-3 py-2 text-sm"
          role="alert"
        >
          {t(`errors.${failure}`)}
        </p>
      )}

      <section aria-labelledby="{{camel}}-create" className="space-y-3">
        <h2 className="text-lg font-semibold" id="{{camel}}-create">
          {t("create.title")}
        </h2>
        <p className="text-muted-foreground text-sm">
          {t("create.description")}
        </p>
        <form
          className="space-y-3"
          noValidate
          onSubmit={handleSubmit((input) => {
            onCreate(input.title);
            reset({ title: "" });
          })}
        >
          <div className="flex flex-wrap items-end gap-3">
            <div className="min-w-56 flex-1 space-y-1.5">
              <Label htmlFor={titleId}>{t("create.label")}</Label>
              <Input
                {...register("title")}
                aria-describedby={
                  errors.title === undefined ? undefined : errorId
                }
                aria-invalid={errors.title !== undefined}
                id={titleId}
              />
            </div>
            <Button disabled={isCreating} type="submit">
              {isCreating ? t("create.submitting") : t("create.submit")}
            </Button>
          </div>
          <{{pascal}}FieldError id={errorId} message={errors.title?.message} />
        </form>
      </section>

      <section aria-labelledby="{{camel}}-list" className="space-y-3">
        <h2 className="text-lg font-semibold" id="{{camel}}-list">
          {t("list.title")}
        </h2>
        {{{camelPlural}}.length === 0 ? (
          <p className="text-muted-foreground text-sm">{t("list.empty")}</p>
        ) : (
          <ul className="divide-border divide-y">
            {{{camelPlural}}.map((entry) => (
              // Keyed by the {{lower}} it is about. The form reads its default
              // value once, so without this a list that reorders would leave a
              // previous title sitting in the field — every unit test passes
              // while that is broken, because each renders it only once.
              <li className="py-3" key={entry.id}>
                <{{pascal}}RenameForm
                  isSaving={isRenaming}
                  onRename={(title) => {
                    setSavedId(entry.id);
                    onRename({ {{camel}}Id: entry.id, title });
                  }}
                  saved={renameSaved && savedId === entry.id}
                  title={entry.title}
                />
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  );
}
