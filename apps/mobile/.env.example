# The mobile app cannot use relative URLs. Use your computer's LAN address when
# testing on a physical device, for example http://192.168.1.20:3000. Both the
# typed API and the account flows (sign-in, verification, password reset) talk to
# this origin, so a wrong value makes the app boot and then fail to sign in.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Sentry (all optional). The DSN is the only one the app itself reads:
# `src/env.ts` parses it and `src/app/_layout.tsx` gates reporting on it.
#
# The other three belong to a native build. `app.config.ts` adds the Sentry Expo
# plugin when org and project are both set, and the plugin's build step runs
# `sentry-cli`, which reads SENTRY_AUTH_TOKEN from the environment to upload
# source maps. That step runs during `expo run:` or an EAS build — never during
# `expo export`, which is what `pnpm build` runs, so nothing in this repository's
# suite reads the token.
EXPO_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
