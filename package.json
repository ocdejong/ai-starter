{
  "name": "ai-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test",
    "db:generate": "pnpm --filter @ai-starter/db db:generate",
    "db:migrate": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate",
    "db:migrate:dev": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate:dev",
    "db:migrate:status": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate:status",
    "db:push:prototype": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:push:prototype",
    "db:studio": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:studio",
    "db:validate": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:validate",
    "dev": "turbo run dev --filter=@ai-starter/web",
    "dev:all": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@ai-starter/mobile",
    "dev:web": "turbo run dev --filter=@ai-starter/web",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "postinstall": "pnpm db:generate",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @ai-starter/web test:e2e",
    "test:e2e:mobile": "pnpm --filter @ai-starter/mobile test:e2e",
    "test:integration": "pnpm --filter @ai-starter/db test:integration",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ],
    "packageExtensions": {
      "@react-native/jest-preset@*": {
        "dependencies": {
          "@babel/runtime": "^7.29.7"
        }
      }
    }
  }
}
