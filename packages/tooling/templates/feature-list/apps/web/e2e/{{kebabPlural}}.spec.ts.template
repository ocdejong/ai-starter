import { expect, test } from "@playwright/test";

import { registerVerifiedAccount } from "./support/account";

/**
 * The example feature slice, driven end to end.
 *
 * This is the journey a generated feature is worth: it is the only check that
 * runs the whole stack the generator emits — the form's schema, the procedure's
 * group scoping, and the PostgreSQL constraint behind it — against a real
 * browser and a real database.
 */
test("adds, renames and accumulates a group's {{lowerPlural}}", async ({
  page,
}) => {
  // Registration, a mailbox round trip, and several routes that each compile on
  // first request against the development server.
  test.setTimeout(180_000);

  await registerVerifiedAccount(page);

  // Scoped to the list's own region. A page-wide `getByRole("listitem")` also
  // matches the shell's navigation, which is four more rows than this journey
  // is about — the component test does not see that, because it renders the
  // panel and nothing around it.
  const rows = page
    .getByRole("region", { name: "All {{lowerPlural}}" })
    .getByRole("listitem");

  await test.step("a new group has nothing to show", async () => {
    await page.getByRole("link", { name: "{{titlePlural}}" }).click();

    await expect(page).toHaveURL("/{{kebabPlural}}", { timeout: 30_000 });
    await expect(
      page.getByText("This group has not added anything yet."),
    ).toBeVisible({ timeout: 30_000 });
  });

  await test.step("add the first one", async () => {
    await page.getByLabel("New title").fill("The first {{lower}}");
    await page.getByRole("button", { name: "Add" }).click();

    await expect(rows).toHaveCount(1, { timeout: 30_000 });
    await expect(rows.first().getByRole("textbox")).toHaveValue(
      "The first {{lower}}",
    );
    await expect(page.getByText("1 {{lower}}")).toBeVisible();
  });

  await test.step("rename it", async () => {
    await rows.first().getByRole("textbox").fill("The renamed {{lower}}");
    await rows.first().getByRole("button", { name: "Save" }).click();

    await expect(page.getByText("Saved.")).toBeVisible();
    await page.reload();
    await expect(rows.first().getByRole("textbox")).toHaveValue(
      "The renamed {{lower}}",
      { timeout: 30_000 },
    );
  });

  await test.step("adding again keeps both", async () => {
    await page.getByLabel("New title").fill("A second {{lower}}");
    await page.getByRole("button", { name: "Add" }).click();

    await expect(rows).toHaveCount(2, { timeout: 30_000 });
    // Newest first, and each field is seeded from its own record — which is what
    // catches a row that was not keyed by the {{lower}} it is about: every unit
    // test passes while the second row shows the first one's title.
    await expect(rows.nth(0).getByRole("textbox")).toHaveValue(
      "A second {{lower}}",
    );
    await expect(rows.nth(1).getByRole("textbox")).toHaveValue(
      "The renamed {{lower}}",
    );
    await expect(page.getByText("2 {{lowerPlural}}")).toBeVisible();
  });
});

test("keeps one group's {{lowerPlural}} out of another's", async ({
  browser,
}) => {
  test.setTimeout(180_000);

  const owner = await browser.newContext();
  const stranger = await browser.newContext();

  try {
    const ownerPage = await owner.newPage();
    await registerVerifiedAccount(ownerPage, { name: "Ada Lovelace" });
    await ownerPage.goto("/{{kebabPlural}}");
    await ownerPage.getByLabel("New title").fill("This group's {{lower}}");
    await ownerPage.getByRole("button", { name: "Add" }).click();
    const ownerRows = ownerPage
      .getByRole("region", { name: "All {{lowerPlural}}" })
      .getByRole("listitem");
    await expect(ownerRows.first().getByRole("textbox")).toHaveValue(
      "This group's {{lower}}",
      { timeout: 30_000 },
    );

    // A second account signs up into its own personal group. The procedures
    // take no group identifier, so there is nothing for this reader to tamper
    // with — and the group behind their session has no {{lowerPlural}}.
    const strangerPage = await stranger.newPage();
    await registerVerifiedAccount(strangerPage, { name: "Grace Hopper" });
    await strangerPage.goto("/{{kebabPlural}}");

    await expect(
      strangerPage.getByText("This group has not added anything yet."),
    ).toBeVisible({ timeout: 30_000 });
    await expect(
      strangerPage
        .getByRole("region", { name: "All {{lowerPlural}}" })
        .getByRole("listitem"),
    ).toHaveCount(0);
  } finally {
    await owner.close();
    await stranger.close();
  }
});
