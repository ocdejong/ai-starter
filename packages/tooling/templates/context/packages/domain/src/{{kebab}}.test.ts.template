import { describe, expect, it } from "vitest";

import {
  {{camel}}TitlePolicy,
  parse{{pascal}}ValidationCode,
  create{{pascal}}InputSchema,
  rename{{pascal}}InputSchema,
} from "./{{kebab}}";

describe("create{{pascal}}InputSchema", () => {
  it("trims the title before it reaches the database", () => {
    const result = create{{pascal}}InputSchema.safeParse({
      title: "  Office closed on Friday  ",
    });

    expect(result).toMatchObject({
      data: { title: "Office closed on Friday" },
      success: true,
    });
  });

  it("reports a blank title as a stable code", () => {
    const result = create{{pascal}}InputSchema.safeParse({ title: "   " });

    expect(result.error?.issues[0]?.message).toBe("{{camel}}TitleRequired");
  });

  it("reports a title past the column limit as a stable code", () => {
    const result = create{{pascal}}InputSchema.safeParse({
      title: "x".repeat({{camel}}TitlePolicy.maxLength + 1),
    });

    expect(result.error?.issues[0]?.message).toBe("{{camel}}TitleTooLong");
  });
});

describe("rename{{pascal}}InputSchema", () => {
  it("requires the {{lower}} it renames", () => {
    const result = rename{{pascal}}InputSchema.safeParse({
      {{camel}}Id: "",
      title: "Still closed",
    });

    expect(result.success).toBe(false);
  });
});

describe("parse{{pascal}}ValidationCode", () => {
  it("narrows a code the catalog can translate", () => {
    expect(parse{{pascal}}ValidationCode("{{camel}}TitleTooLong")).toBe(
      "{{camel}}TitleTooLong",
    );
  });

  it("refuses anything else rather than guessing", () => {
    expect(parse{{pascal}}ValidationCode("String must contain…")).toBeNull();
  });
});
