{
  "name": "t3-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test",
    "db:generate": "pnpm --filter @t3-test/db db:generate",
    "db:migrate": "dotenv -e apps/web/.env -- pnpm --filter @t3-test/db db:migrate",
    "db:migrate:dev": "dotenv -e apps/web/.env -- pnpm --filter @t3-test/db db:migrate:dev",
    "db:migrate:status": "dotenv -e apps/web/.env -- pnpm --filter @t3-test/db db:migrate:status",
    "db:push:prototype": "dotenv -e apps/web/.env -- pnpm --filter @t3-test/db db:push:prototype",
    "db:studio": "dotenv -e apps/web/.env -- pnpm --filter @t3-test/db db:studio",
    "dev": "turbo run dev --filter=@t3-test/web",
    "dev:all": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@t3-test/mobile",
    "dev:web": "turbo run dev --filter=@t3-test/web",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "postinstall": "pnpm db:generate",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @t3-test/web test:e2e",
    "test:e2e:mobile": "pnpm --filter @t3-test/mobile test:e2e",
    "test:integration": "pnpm --filter @t3-test/db test:integration",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  }
}
