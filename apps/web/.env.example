# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth. `pnpm bootstrap` generates one; a production
# deployment must supply at least 32 characters.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Turns off Better Auth's per-IP request limit on the auth endpoints. The
# browser suite sets it for the servers it starts, because every journey it runs
# shares one address. Leave it empty here and in any deployment: the limit is
# the brute-force guard, and `pnpm diagnose` fails while this is "true".
BETTER_AUTH_RATE_LIMIT_DISABLED=""

# Lets the on-disk dev mailbox serve a production build. The browser suite sets
# it for the servers it starts, because CI serves `next start` and its journeys
# read the mail they trigger. Leave it empty here and in any deployment: the
# mailbox writes every action link — a bearer token — to .mail/ and the log,
# and `pnpm diagnose` fails while this is "true".
EMAIL_DEV_MAILBOX_ENABLED=""

# Better Auth GitHub OAuth. Both halves or neither: one alone configures
# nothing, and the landing page falls back to email sign-in without saying why.
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5433/ai-starter"

# Transactional email (optional)
# With no RESEND_API_KEY the app writes email to a local dev mailbox (.mail/)
# instead of sending it, so a fresh clone still boots. Set a Resend API key
# (it begins with "re_") to send for real: https://resend.com/api-keys
RESEND_API_KEY=""
# From address for outgoing mail: an email address or "Name <address>".
# Unverified Resend accounts can only send from onboarding@resend.dev.
EMAIL_FROM=""

# LLM chat (optional)
# With no ANTHROPIC_API_KEY the chat on the landing page renders a "not
# configured" state instead of calling a provider, so a fresh clone still boots.
# Create a key (it begins with "sk-ant-") at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Model the chat answers with. Swapping models is this one variable.
AI_CHAT_MODEL="claude-sonnet-5"

# Sentry (optional; SENTRY_AUTH_TOKEN is only needed for source-map uploads)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
