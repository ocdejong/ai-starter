{
  "name": "ai-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "bootstrap": "node packages/tooling/src/bin/bootstrap.ts",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @ai-starter/db db:generate",
    "db:lint": "node packages/tooling/src/bin/db-lint.ts",
    "db:migrate": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate",
    "db:migrate:dev": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate:dev",
    "db:migrate:status": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:migrate:status",
    "db:push:prototype": "dotenv -e apps/web/.env -- node packages/tooling/src/bin/db-push-prototype.ts",
    "db:seed": "dotenv -e apps/web/.env -- node packages/tooling/src/bin/db-seed.ts",
    "db:studio": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:studio",
    "db:validate": "dotenv -e apps/web/.env -- pnpm --filter @ai-starter/db db:validate",
    "deps:backlog": "node packages/tooling/src/bin/deps-backlog.ts",
    "dev": "turbo run dev --filter=@ai-starter/web",
    "dev:all": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@ai-starter/mobile",
    "email:preview": "pnpm --filter @ai-starter/email email",
    "diagnose": "node packages/tooling/src/bin/diagnose.ts",
    "format": "pnpm format:write",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "generate": "node packages/tooling/src/bin/generate.ts",
    "instructions": "node packages/tooling/src/bin/instructions.ts",
    "instructions:write": "node packages/tooling/src/bin/instructions.ts --write",
    "knip": "knip",
    "links:check": "node packages/tooling/src/bin/check-links.ts",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "mutation": "pnpm --filter @ai-starter/domain --filter @ai-starter/api mutation",
    "policy": "node packages/tooling/src/bin/policy.ts",
    "postinstall": "pnpm db:generate",
    "rehearse:template": "node packages/tooling/src/bin/rehearse-template.ts",
    "repo:host": "node packages/tooling/src/bin/repo-host.ts",
    "starter:init": "node packages/tooling/src/bin/starter-init.ts",
    "test:e2e": "pnpm --filter @ai-starter/web test:e2e",
    "test:e2e:mobile": "node packages/tooling/src/bin/native-journey.ts",
    "test:integration": "pnpm --filter @ai-starter/db --filter @ai-starter/auth test:integration",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "node packages/tooling/src/bin/verify.ts",
    "verify:changed": "node packages/tooling/src/bin/verify-changed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "dependency-cruiser": "^18.1.0",
    "dotenv-cli": "^11.0.0",
    "knip": "^6.29.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "squawk-cli": "^2.61.0",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^24 || >=26"
  }
}
